{
    "name": "mod_companion",
    "productName": "Mod Companion",
    "version": "1.0.0",
    "description": "Source Engine Modding Tool",
    "type": "module",
    "keywords": [],
    "private": true,
    "author": {
        "name": "Second Face Software",
        "email": "hello@secondfacesoftware.com"
    },
    "scripts": {
        "run-dist": "cross-env node_modules/.bin/electron build/main/main.cjs",
        "run-dev": "cross-env NODE_ENV=development electron --trace-warnings build/main/main.cjs",
        "run-dev-break": "cross-env NODE_ENV=development electron --inspect-brk=9229 build/main/main.cjs",
        "dev": "npm run copyassets && concurrently -k -n PRELOAD,MAIN,VITE -c blue,green,magenta \"npm:dev:preload\" \"npm:dev:main\" \"npm:dev:renderer\"",
        "dev:main": "node scripts/build.mjs watch",
        "dev:renderer": "npm run dev -w src/renderer",
        "dev:preload": "esbuild --watch src/main/preload.ts --bundle --platform=node --external:electron --outfile=./build/preload.js",
        "build": "npm run copyassets && npm run build:preload && npm run build:main && npm run build:renderer",
        "build:main": "node scripts/build.mjs",
        "build:renderer": "cd src/renderer && npm run build",
        "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --external:electron --outfile=./build/preload.js",
        "copyassets": "copyfiles -u 1 main_assets/* build/main_assets && copyfiles -u 1 main_assets/**/* build/main_assets",
        "deploy": "npm run build && node scripts/deploy.cjs",
        "test": "vitest",
        "lint": "eslint src",
        "lint-fix": "eslint src --fix",
        "check": "cd src/shared; npm run check; cd ../core; npm run check; cd ../main; npm run check; cd ../renderer; npm run check",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "copyfiles": "^2.4.1",
        "cross-env": "^10.1.0",
        "esbuild": "^0.27.3",
        "fs-extra": "^11.3.6",
        "prettier": "^3.8.1"
    },
    "workspaces": [
        "src/*"
    ]
}
